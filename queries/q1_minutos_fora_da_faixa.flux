// Q1: minutos fora da faixa 2-8 °C por loja, nos últimos 30 dias (cada ponto = 60 s em produção)
from(bucket: "sensores")
  |> range(start: -30d)
  |> filter(fn: (r) => r._measurement == "temperatura_camara" and r._field == "temp_c")
  |> map(fn: (r) => ({ r with _value: if r._value < 2.0 or r._value > 8.0 then 1 else 0 }))
  |> group(columns: ["regiao", "loja"])
  |> sum()
  |> rename(columns: {_value: "minutos_fora_da_faixa"})
  |> group()
  |> sort(columns: ["minutos_fora_da_faixa"], desc: true)
