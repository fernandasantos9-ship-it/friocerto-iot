{
  "uid": "friocerto-central",
  "title": "FrioCerto: câmaras frias (ABC)",
  "tags": [
    "friocerto",
    "cadeia-fria"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperatura por loja (últimos 15 min)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-friocerto"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-friocerto"
          },
          "query": "from(bucket: \"sensores\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temperatura_camara\" and r._field == \"temp_c\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "max": 14,
          "displayName": "${__field.labels.loja}",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "drawStyle": "line",
            "fillOpacity": 0,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 2
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Lojas fora da faixa agora",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-friocerto"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-friocerto"
          },
          "query": "from(bucket: \"sensores\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"temperatura_camara\" and r._field == \"temp_c\")\n  |> last()\n  |> map(fn: (r) => ({ r with _value: if r._value < 2.0 or r._value > 8.0 then 1 else 0 }))\n  |> group()\n  |> sum()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Última leitura por loja",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-friocerto"
      },
      "gridPos": {
        "h": 10,
        "w": 18,
        "x": 6,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-friocerto"
          },
          "query": "from(bucket: \"sensores\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"temperatura_camara\" and r._field == \"temp_c\")\n  |> last()\n  |> group()\n  |> keep(columns: [\"regiao\", \"loja\", \"_value\"])\n  |> rename(columns: {_value: \"temp_c\"})\n  |> sort(columns: [\"loja\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "temp_c"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}